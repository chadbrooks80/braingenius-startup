// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [citext]
}

enum UserRole {
  PARENT
  TEACHER
  STUDENT
  CHILD
  ADMIN
}

enum SubscriptionTier {
  FREE_TRIAL
  MONTHLY
  LIFETIME
  ADMIN
  CANCELED
}

enum OnboardingStep {
  VERIFY_EMAIL
  WELCOME_VIDEO
  PROFILE
  PLAN
  CHILDREN
  COMPLETE
}

enum TtsUsageScope {
  CALLER_MINUTE
  CALLER_DAY
  ENTITLEMENT_DAY
}

enum TtsRequestKind {
  PUBLIC_TEXT
  PROTECTED_TEXT
}

enum TtsProvider {
  GOOGLE
  LEMONFOX
}

enum TtsUsageAlertKind {
  FIVE_HOUR_WARNING
  TEN_HOUR_CUTOFF
}

enum ModVocabContentSource {
  WORD_ONLY
  DICTIONARY
  TEACHER
  MIXED

  @@map("mod_vocab_content_source")
}

enum ModVocabLearningStatus {
  ACTIVE
  COMPLETED
  ARCHIVED

  @@map("mod_vocab_learning_status")
}

enum ModVocabReviewStage {
  IDLE
  DEFINITION_PENDING
  SPELLING_PENDING

  @@map("mod_vocab_review_stage")
}

enum ModVocabSessionStatus {
  ACTIVE
  ENDED
  ABANDONED

  @@map("mod_vocab_session_status")
}

enum ModVocabAttemptType {
  DEFINITION
  SPELLING

  @@map("mod_vocab_attempt_type")
}

enum ModVocabAttemptStatus {
  ACTIVE
  ANSWERED
  CANCELED
  EXPIRED

  @@map("mod_vocab_attempt_status")
}

model User {
  id                      String         @id @default(cuid())
  isOwner                 Boolean?
  name                    String?
  fName                   String?
  lName                   String?
  email                   String?        @unique @db.Citext
  emailVerified           DateTime?
  username                String?        @unique
  image                   String?
  password                String?
  role                    UserRole?
  onboardingCompleted     Boolean        @default(false)
  onboardingStep          OnboardingStep @default(VERIFY_EMAIL)
  mustResetPassword       Boolean        @default(false)
  // Manual TTS suspension applied by an authorized operator after abuse
  // review; never written automatically by warning/cutoff enforcement.
  // The reason code is server-only operational state.
  ttsSuspendedAt          DateTime?
  ttsSuspensionReasonCode String?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  accounts             Account[]
  sessions             Session[]
  parents              ParentStudent[]      @relation("StudentParents")
  students             ParentStudent[]      @relation("ParentStudents")
  subscription         Subscription?
  passwordResetTokens  PasswordResetToken[]
  ttsUsageBuckets      TtsUsageBucket[]
  ttsAlertsAsCaller    TtsUsageAlert[]      @relation("TtsUsageAlertCaller")
  ttsAlertsAsPrincipal TtsUsageAlert[]      @relation("TtsUsageAlertPrincipal")
  ttsLeasesAsCaller    TtsRequestLease[]    @relation("TtsCallerLeases")
  ttsLeasesAsPrincipal TtsRequestLease[]    @relation("TtsPrincipalLeases")

  modVocabLists              ModVocabList[]          @relation("ModVocabListOwner")
  modVocabLearningsAsLearner ModVocabLearning[]      @relation("ModVocabLearningLearner")
  modVocabLearningsAssigned  ModVocabLearning[]      @relation("ModVocabLearningAssignedBy")
  modVocabDailyPractice      ModVocabDailyPractice[] @relation("ModVocabDailyPracticeLearner")
}

model ParentStudent {
  parentId  String
  studentId String
  createdAt DateTime @default(now())

  parent  User @relation("ParentStudents", fields: [parentId], references: [id], onDelete: Cascade)
  student User @relation("StudentParents", fields: [studentId], references: [id], onDelete: Cascade)

  @@id([parentId, studentId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                   String            @id @default(cuid())
  userId               String            @unique
  tier                 SubscriptionTier?
  trialStartedAt       DateTime?
  trialEndsAt          DateTime?
  stripeCustomerId     String?           @unique
  stripeSubscriptionId String?           @unique
  stripePriceId        String?
  stripeStatus         String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean           @default(false)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Durable per-window paid TTS usage counters. Enforcement sums across the
// provider/requestKind rows for one subject+scope+window; the rows stay
// separate so operational reports can break usage down per provider and
// request kind. No spoken text or audio is ever stored here.
model TtsUsageBucket {
  id                      String         @id @default(cuid())
  subjectUserId           String
  scope                   TtsUsageScope
  windowStart             DateTime
  provider                TtsProvider
  requestKind             TtsRequestKind
  acceptedRequests        Int            @default(0)
  acceptedInputBytes      Int            @default(0)
  acceptedInputCharacters Int            @default(0)
  acceptedWords           Int            @default(0)
  successfulRequests      Int            @default(0)
  failedRequests          Int            @default(0)
  rejectedBurst           Int            @default(0)
  rejectedConcurrency     Int            @default(0)
  rejectedExtremeUsage    Int            @default(0)
  generatedAudioBytes     BigInt         @default(0)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  subjectUser User @relation(fields: [subjectUserId], references: [id], onDelete: Cascade)

  @@unique([subjectUserId, scope, windowStart, provider, requestKind])
  @@index([subjectUserId, scope, windowStart])
}

// At most one warning and one cutoff alert row per caller per UTC day,
// enforced by the unique constraint so concurrent threshold crossings
// cannot create duplicates.
model TtsUsageAlert {
  id                         String            @id @default(cuid())
  callerUserId               String
  entitlementPrincipalUserId String
  dayStart                   DateTime
  kind                       TtsUsageAlertKind
  observedWords              Int
  createdAt                  DateTime          @default(now())

  caller               User @relation("TtsUsageAlertCaller", fields: [callerUserId], references: [id], onDelete: Cascade)
  entitlementPrincipal User @relation("TtsUsageAlertPrincipal", fields: [entitlementPrincipalUserId], references: [id], onDelete: Cascade)

  @@unique([callerUserId, dayStart, kind])
  @@index([entitlementPrincipalUserId, dayStart])
}

// Cross-instance in-flight provider attempt. A lease expires after 30
// seconds so a crashed invocation cannot block its caller permanently.
// It stores only numeric completion metadata, never spoken content.
model TtsRequestLease {
  id                         String         @id @default(cuid())
  callerUserId               String
  entitlementPrincipalUserId String
  provider                   TtsProvider
  requestKind                TtsRequestKind
  inputBytes                 Int
  inputCharacters            Int
  inputWords                 Int
  callerMinuteStart          DateTime
  callerDayStart             DateTime
  principalDayStart          DateTime
  expiresAt                  DateTime
  createdAt                  DateTime       @default(now())

  caller               User @relation("TtsCallerLeases", fields: [callerUserId], references: [id], onDelete: Cascade)
  entitlementPrincipal User @relation("TtsPrincipalLeases", fields: [entitlementPrincipalUserId], references: [id], onDelete: Cascade)

  @@index([callerUserId, expiresAt])
  @@index([entitlementPrincipalUserId, expiresAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model EmailVerificationCode {
  id String @id @default(cuid())

  email    String @db.Citext
  codeHash String

  expiresAt DateTime
  usedAt    DateTime?

  attempts Int @default(0)

  createdAt DateTime @default(now())

  @@index([email])
}

model PasswordResetToken {
  id String @id @default(cuid())

  userId String

  tokenHash String @unique

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Vocabulary module persistence. Every physical table is prefixed
// mod_vocab_ to mark it as owned by the Vocabulary learning module. See
// docs/modules/vocabulary-persistence-schema.md for the full data model.

// A reusable ordered Vocabulary list owned by its creator. One list may be
// assigned to many learners as independent ModVocabLearning records.
model ModVocabList {
  id          String   @id @default(cuid())
  ownerUserId String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner User @relation("ModVocabListOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)

  words     ModVocabListWord[]
  learnings ModVocabLearning[]

  @@index([ownerUserId, createdAt])
  @@map("mod_vocab_lists")
}

// One ordered, list-specific Vocabulary content snapshot. Content fields
// besides word may be temporarily incomplete until a future Dictionary
// hydration feature fills only missing fields; teacher content always wins.
model ModVocabListWord {
  id                String  @id @default(cuid())
  listId            String
  dictionaryEntryId String?
  position          Int
  word              String
  normalizedWord    String

  definition         String?
  spellingDefinition String?
  exampleSentence1   String?
  exampleSentence2   String?
  exampleSentence3   String?
  interestingFact    String?
  contentSource      ModVocabContentSource @default(WORD_ONLY)
  contentResolvedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  list ModVocabList @relation(fields: [listId], references: [id], onDelete: Cascade)

  progress       ModVocabWordProgress[]
  attempts       ModVocabAttempt[]
  sourcedChoices ModVocabAttemptChoice[] @relation("ModVocabAttemptChoiceSource")

  @@unique([listId, position])
  @@unique([listId, normalizedWord])
  @@index([dictionaryEntryId])
  @@index([listId, position])
  @@map("mod_vocab_list_words")
}

// The learner-specific assignment/enrollment represented by learningId in
// the future Vocabulary route. The same list may be assigned to a learner
// more than once, so (learnerUserId, listId) is intentionally not unique.
model ModVocabLearning {
  id                         String                 @id @default(cuid())
  listId                     String
  learnerUserId              String
  assignedByUserId           String?
  status                     ModVocabLearningStatus @default(ACTIVE)
  dailyGoalSeconds           Int                    @default(1800)
  gradedAnswerCount          Int                    @default(0)
  correctAnswerCount         Int                    @default(0)
  incorrectAnswerCount       Int                    @default(0)
  servedCheckpointGroupCount Int                    @default(0)
  startedAt                  DateTime               @default(now())
  completedAt                DateTime?
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt

  list       ModVocabList @relation(fields: [listId], references: [id], onDelete: Cascade)
  learner    User         @relation("ModVocabLearningLearner", fields: [learnerUserId], references: [id], onDelete: Cascade)
  assignedBy User?        @relation("ModVocabLearningAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  wordProgress ModVocabWordProgress[]
  sessions     ModVocabSession[]

  @@index([learnerUserId, status])
  @@index([listId])
  @@index([assignedByUserId])
  @@map("mod_vocab_learnings")
}

// Durable progress for exactly one list word inside one learner's Vocabulary
// learning record. initialMasterySequence/firstMasteredAt record the first
// time the word ever reaches full mastery and are never cleared by a later
// review failure, so the existing five-word checkpoint groups stay durable.
model ModVocabWordProgress {
  id                           String              @id @default(cuid())
  learningId                   String
  listWordId                   String
  introduced                   Boolean             @default(false)
  introducedAt                 DateTime?
  definitionConsecutiveCorrect Int                 @default(0)
  definitionMastered           Boolean             @default(false)
  definitionMasteredAt         DateTime?
  spellingConsecutiveCorrect   Int                 @default(0)
  spellingMastered             Boolean             @default(false)
  spellingMasteredAt           DateTime?
  practicePresentationCount    Int                 @default(0)
  reviewStage                  ModVocabReviewStage @default(IDLE)
  nextReviewQuestionNumber     Int?
  totalCorrect                 Int                 @default(0)
  totalIncorrect               Int                 @default(0)
  initialMasterySequence       Int?
  firstMasteredAt              DateTime?
  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime            @updatedAt

  learning ModVocabLearning @relation(fields: [learningId], references: [id], onDelete: Cascade)
  listWord ModVocabListWord @relation(fields: [listWordId], references: [id], onDelete: Cascade)

  @@unique([learningId, listWordId])
  @@unique([learningId, initialMasterySequence])
  @@index([learningId, spellingMastered])
  @@index([learningId, reviewStage, nextReviewQuestionNumber])
  @@index([listWordId])
  @@map("mod_vocab_word_progress")
}

// One durable learner visit/session within a Vocabulary learning record.
model ModVocabSession {
  id                   String                @id @default(uuid())
  learningId           String
  status               ModVocabSessionStatus @default(ACTIVE)
  stateVersion         Int                   @default(0)
  activeSeconds        Int                   @default(0)
  gradedAnswerCount    Int                   @default(0)
  correctAnswerCount   Int                   @default(0)
  incorrectAnswerCount Int                   @default(0)
  startedAt            DateTime              @default(now())
  lastActivityAt       DateTime              @default(now())
  endedAt              DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  learning ModVocabLearning  @relation(fields: [learningId], references: [id], onDelete: Cascade)
  attempts ModVocabAttempt[]

  @@index([learningId, startedAt])
  @@index([learningId, status])
  @@map("mod_vocab_sessions")
}

// A durable, idempotent definition or spelling attempt bound to one session
// and list word. correctAnswerSnapshot/submittedAnswer are server-only and
// must never be returned in a public lesson projection.
model ModVocabAttempt {
  id                    String                @id @default(uuid())
  sessionId             String
  listWordId            String
  answerType            ModVocabAttemptType
  status                ModVocabAttemptStatus @default(ACTIVE)
  review                Boolean               @default(false)
  correctAnswerSnapshot String?
  submittedAnswer       String?
  wasCorrect            Boolean?
  createdAt             DateTime              @default(now())
  answeredAt            DateTime?
  updatedAt             DateTime              @updatedAt

  session  ModVocabSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  listWord ModVocabListWord @relation(fields: [listWordId], references: [id], onDelete: Cascade)

  choices ModVocabAttemptChoice[]

  @@index([sessionId, status])
  @@index([listWordId, createdAt])
  @@map("mod_vocab_attempts")
}

// Durable server-authoritative choice snapshots for a definition attempt.
// id is the opaque public choice ID exposed to the browser.
model ModVocabAttemptChoice {
  id               String   @id @default(uuid())
  attemptId        String
  sourceListWordId String?
  position         Int
  textSnapshot     String
  isCorrect        Boolean
  createdAt        DateTime @default(now())

  attempt        ModVocabAttempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  sourceListWord ModVocabListWord? @relation("ModVocabAttemptChoiceSource", fields: [sourceListWordId], references: [id], onDelete: SetNull)

  @@unique([attemptId, position])
  @@unique([attemptId, sourceListWordId])
  @@index([sourceListWordId])
  @@map("mod_vocab_attempt_choices")
}

// Module-owned daily study-time and answer totals aggregated across a
// learner's Vocabulary sessions for one calendar date, used later by the
// Vocabulary module panel and dashboard.
model ModVocabDailyPractice {
  id                String    @id @default(cuid())
  learnerUserId     String
  practiceDate      DateTime  @db.Date
  goalSeconds       Int       @default(1800)
  secondsStudied    Int       @default(0)
  questionsAnswered Int       @default(0)
  correctAnswers    Int       @default(0)
  goalReachedAt     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  learner User @relation("ModVocabDailyPracticeLearner", fields: [learnerUserId], references: [id], onDelete: Cascade)

  @@unique([learnerUserId, practiceDate])
  @@index([learnerUserId, practiceDate])
  @@map("mod_vocab_daily_practice")
}
